{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["node"]
  },
  "include": [
    "src",
    "tests/**/*",
    "jest.config.ts",
    "expo-env.d.ts",
    ".expo/types/**/*.ts"
  ]
}
